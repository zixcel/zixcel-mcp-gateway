{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zixcel.com/schema/public-catalog.schema.json",
  "title": "Product-neutral Zixcel public MCP catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "server", "resource"],
  "properties": {
    "schema_version": { "const": 1 },
    "server": { "$ref": "#/$defs/server" },
    "resource": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$|^[a-z]$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "instructions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
