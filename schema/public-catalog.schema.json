{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zixcel.com/schema/public-catalog.schema.json",
  "title": "Product-neutral Zixcel public MCP catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server",
    "resource"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "resource": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$|^[a-z]$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instructions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "document": {
          "$ref": "#/$defs/document"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "media_type",
        "source_url",
        "sha256",
        "license",
        "attribution",
        "text"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown"
          ]
        },
        "source_url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "resource": {
            "items": {
              "not": {
                "required": [
                  "document"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
